#version 430 core
layout(local_size_x = 64) in;
struct Particle { vec4 pos; vec4 vel; };
layout(std430, binding = 0) buffer Particles { uint count; float dt; Particle p[]; } particles;
layout(std430, binding = 1) buffer Out { vec3 v3[4]; float tail[]; };
layout(binding = 2, offset = 4) uniform atomic_uint hits;
shared float scratch[64];
shared uint sharedCount;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (gl_LocalInvocationIndex == 0u) sharedCount = 0u;
    barrier();
    if (i >= uint(particles.p.length())) return;
    Particle pt = particles.p[i];
    pt.pos.xyz += pt.vel.xyz * particles.dt;
    particles.p[i] = pt;
    particles.p[i].vel.y -= 9.8 * particles.dt;
    particles.p[i].pos.w++;
    scratch[gl_LocalInvocationID.x] = pt.pos.x;
    atomicAdd(sharedCount, 1u);
    memoryBarrierShared();
    barrier();
    if (gl_LocalInvocationID.x == 0u) {
        float s = 0.0;
        for (int k = 0; k < 64; k++) s += scratch[k];
        tail[gl_WorkGroupID.x] = s;
        atomicAdd(particles.count, sharedCount);
        atomicCounterIncrement(hits);
        v3[1].yz = vec2(s, float(tail.length()));
    }
}
