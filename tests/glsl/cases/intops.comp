#version 430
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) buffer B { uint u[]; };
layout(rgba8, binding = 0) uniform writeonly image2D outImg;
layout(r32ui, binding = 1) uniform uimage2D counts;
layout(rgba16f, binding = 2) uniform readonly image2DArray inImg;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    uint x = u[p.x];
    uint carry, hi, lo;
    uint s = uaddCarry(x, 0xffffffffu, carry);
    umulExtended(x, 3u, hi, lo);
    int msb = findMSB(int(x)) + findLSB(x) + bitCount(x);
    uint e = bitfieldExtract(x, 4, 8) | bitfieldInsert(x, 5u, 0, 3) ^ bitfieldReverse(x);
    uint packed = packUnorm4x8(vec4(0.5)) + packHalf2x16(vec2(1.0, 2.0));
    vec2 un = unpackHalf2x16(packed) + unpackSnorm2x16(x);
    int ib = floatBitsToInt(un.x) << 2 >> 1;
    u[p.y] = s + carry + hi + lo + uint(msb) + e + uint(ib) + (x % 7u) + (x >> 3) + ~x;
    vec4 v = imageLoad(inImg, ivec3(p, 1));
    imageStore(outImg, p, v);
    uint old = imageAtomicAdd(counts, p, 1u);
    imageAtomicCompSwap(counts, p, old, 5u);
    ivec2 isz = imageSize(outImg);
    u[0] += uint(isz.x);
}
