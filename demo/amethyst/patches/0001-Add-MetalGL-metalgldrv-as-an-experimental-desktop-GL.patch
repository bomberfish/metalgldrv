 "preference.detail.renderer" = "Change the OpenGL render engine to use. Zink is temporarily disabled on iOS 16 and later to diagnose issues.";
 
diff --git a/Natives/utils.h b/Natives/utils.h
index 431b61e..c9bc0cb 100644
--- a/Natives/utils.h
+++ b/Natives/utils.h
@@ -38,6 +38,7 @@
 #define RENDERER_NAME_MTL_ANGLE "libtinygl4angle.dylib"
 #define RENDERER_NAME_MOBILEGLUES "libmobileglues.dylib"
 #define RENDERER_NAME_VK_ZINK "libOSMesa.8.dylib"
+#define RENDERER_NAME_METALGL "libmetalgldrv.dylib"
 
 #define SPECIALBTN_KEYBOARD -1
