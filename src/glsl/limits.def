// GLSL built-in limit constants and the GL limits that report them: one table so
// glGet* and gl_Max* always agree. X(glsl name, GL enum or 0 if GLSL-only, value).
// Included by src/glsl/builtins.cpp (preamble) and src/gl/api_get.mm (queries).
X(gl_MaxVertexAttribs, GL_MAX_VERTEX_ATTRIBS, 16)
X(gl_MaxVertexUniformComponents, GL_MAX_VERTEX_UNIFORM_COMPONENTS, 16384)
X(gl_MaxVaryingFloats, GL_MAX_VARYING_FLOATS, 124)
X(gl_MaxVaryingComponents, GL_MAX_VARYING_COMPONENTS, 124)
X(gl_MaxVertexOutputComponents, GL_MAX_VERTEX_OUTPUT_COMPONENTS, 128)  // > 124 read by the FS: vertex mesh + spill
X(gl_MaxGeometryInputComponents, GL_MAX_GEOMETRY_INPUT_COMPONENTS, 128)
X(gl_MaxGeometryOutputComponents, GL_MAX_GEOMETRY_OUTPUT_COMPONENTS, 128)
X(gl_MaxFragmentInputComponents, GL_MAX_FRAGMENT_INPUT_COMPONENTS, 128)  // > 124 from GS/TES: varying spill (msl.cpp)
X(gl_MaxVertexTextureImageUnits, GL_MAX_VERTEX_TEXTURE_IMAGE_UNITS, 32)
X(gl_MaxCombinedTextureImageUnits, GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS, 96)
X(gl_MaxTextureImageUnits, GL_MAX_TEXTURE_IMAGE_UNITS, 32)
X(gl_MaxImageUnits, GL_MAX_IMAGE_UNITS, 16)
X(gl_MaxCombinedImageUnitsAndFragmentOutputs, GL_MAX_COMBINED_IMAGE_UNITS_AND_FRAGMENT_OUTPUTS, 32)  // same enum as ..._SHADER_OUTPUT_RESOURCES
X(gl_MaxImageSamples, GL_MAX_IMAGE_SAMPLES, 0)  // kStrictMaxImageSamples under METALGLDRV_STRICT
X(gl_MaxVertexImageUniforms, GL_MAX_VERTEX_IMAGE_UNIFORMS, 16)
X(gl_MaxTessControlImageUniforms, GL_MAX_TESS_CONTROL_IMAGE_UNIFORMS, 16)
X(gl_MaxTessEvaluationImageUniforms, GL_MAX_TESS_EVALUATION_IMAGE_UNIFORMS, 16)
X(gl_MaxGeometryImageUniforms, GL_MAX_GEOMETRY_IMAGE_UNIFORMS, 16)
X(gl_MaxFragmentImageUniforms, GL_MAX_FRAGMENT_IMAGE_UNIFORMS, 16)
X(gl_MaxComputeImageUniforms, GL_MAX_COMPUTE_IMAGE_UNIFORMS, 16)
X(gl_MaxCombinedImageUniforms, GL_MAX_COMBINED_IMAGE_UNIFORMS, 96)  // 16 per stage, summed over the 6 stages
X(gl_MaxFragmentUniformComponents, GL_MAX_FRAGMENT_UNIFORM_COMPONENTS, 16384)
X(gl_MaxDrawBuffers, GL_MAX_DRAW_BUFFERS, 8)
X(gl_MaxClipDistances, GL_MAX_CLIP_DISTANCES, 8)
X(gl_MaxCullDistances, GL_MAX_CULL_DISTANCES, 8)
X(gl_MaxCombinedClipAndCullDistances, GL_MAX_COMBINED_CLIP_AND_CULL_DISTANCES, 8)
X(gl_MaxGeometryTextureImageUnits, GL_MAX_GEOMETRY_TEXTURE_IMAGE_UNITS, 32)
X(gl_MaxGeometryOutputVertices, GL_MAX_GEOMETRY_OUTPUT_VERTICES, 256)
X(gl_MaxGeometryTotalOutputComponents, GL_MAX_GEOMETRY_TOTAL_OUTPUT_COMPONENTS, 1024)
X(gl_MaxGeometryUniformComponents, GL_MAX_GEOMETRY_UNIFORM_COMPONENTS, 16384)
X(gl_MaxGeometryVaryingComponents, 0, 124)
X(gl_MaxTessControlInputComponents, GL_MAX_TESS_CONTROL_INPUT_COMPONENTS, 128)
X(gl_MaxTessControlOutputComponents, GL_MAX_TESS_CONTROL_OUTPUT_COMPONENTS, 128)
X(gl_MaxTessControlTextureImageUnits, GL_MAX_TESS_CONTROL_TEXTURE_IMAGE_UNITS, 32)
X(gl_MaxTessControlUniformComponents, GL_MAX_TESS_CONTROL_UNIFORM_COMPONENTS, 16384)
X(gl_MaxTessControlTotalOutputComponents, GL_MAX_TESS_CONTROL_TOTAL_OUTPUT_COMPONENTS, 4096)
X(gl_MaxTessEvaluationInputComponents, GL_MAX_TESS_EVALUATION_INPUT_COMPONENTS, 128)
X(gl_MaxTessEvaluationOutputComponents, GL_MAX_TESS_EVALUATION_OUTPUT_COMPONENTS, 128)
X(gl_MaxTessEvaluationTextureImageUnits, GL_MAX_TESS_EVALUATION_TEXTURE_IMAGE_UNITS, 32)
X(gl_MaxTessEvaluationUniformComponents, GL_MAX_TESS_EVALUATION_UNIFORM_COMPONENTS, 16384)
X(gl_MaxTessPatchComponents, GL_MAX_TESS_PATCH_COMPONENTS, 120)
X(gl_MaxPatchVertices, GL_MAX_PATCH_VERTICES, 32)
X(gl_MaxTessGenLevel, GL_MAX_TESS_GEN_LEVEL, 64)
X(gl_MaxViewports, GL_MAX_VIEWPORTS, 16)
X(gl_MaxVertexUniformVectors, GL_MAX_VERTEX_UNIFORM_VECTORS, 4096)
X(gl_MaxFragmentUniformVectors, GL_MAX_FRAGMENT_UNIFORM_VECTORS, 4096)
X(gl_MaxVaryingVectors, GL_MAX_VARYING_VECTORS, 31)
X(gl_MaxVertexAtomicCounters, GL_MAX_VERTEX_ATOMIC_COUNTERS, 1024)
X(gl_MaxTessControlAtomicCounters, GL_MAX_TESS_CONTROL_ATOMIC_COUNTERS, 1024)
X(gl_MaxTessEvaluationAtomicCounters, GL_MAX_TESS_EVALUATION_ATOMIC_COUNTERS, 1024)
X(gl_MaxGeometryAtomicCounters, GL_MAX_GEOMETRY_ATOMIC_COUNTERS, 1024)
X(gl_MaxFragmentAtomicCounters, GL_MAX_FRAGMENT_ATOMIC_COUNTERS, 1024)
X(gl_MaxCombinedAtomicCounters, GL_MAX_COMBINED_ATOMIC_COUNTERS, 1024)
X(gl_MaxAtomicCounterBindings, GL_MAX_ATOMIC_COUNTER_BUFFER_BINDINGS, 8)
X(gl_MaxVertexAtomicCounterBuffers, GL_MAX_VERTEX_ATOMIC_COUNTER_BUFFERS, 8)
X(gl_MaxTessControlAtomicCounterBuffers, GL_MAX_TESS_CONTROL_ATOMIC_COUNTER_BUFFERS, 8)
X(gl_MaxTessEvaluationAtomicCounterBuffers, GL_MAX_TESS_EVALUATION_ATOMIC_COUNTER_BUFFERS, 8)
X(gl_MaxGeometryAtomicCounterBuffers, GL_MAX_GEOMETRY_ATOMIC_COUNTER_BUFFERS, 8)
X(gl_MaxFragmentAtomicCounterBuffers, GL_MAX_FRAGMENT_ATOMIC_COUNTER_BUFFERS, 8)
X(gl_MaxCombinedAtomicCounterBuffers, GL_MAX_COMBINED_ATOMIC_COUNTER_BUFFERS, 8)
X(gl_MaxAtomicCounterBufferSize, GL_MAX_ATOMIC_COUNTER_BUFFER_SIZE, 65536)
X(gl_MinProgramTexelOffset, GL_MIN_PROGRAM_TEXEL_OFFSET, -8)
X(gl_MaxProgramTexelOffset, GL_MAX_PROGRAM_TEXEL_OFFSET, 7)
X(gl_MaxTransformFeedbackBuffers, GL_MAX_TRANSFORM_FEEDBACK_BUFFERS, 4)
X(gl_MaxTransformFeedbackInterleavedComponents, GL_MAX_TRANSFORM_FEEDBACK_INTERLEAVED_COMPONENTS, 128)
X(gl_MaxComputeUniformComponents, GL_MAX_COMPUTE_UNIFORM_COMPONENTS, 16384)
X(gl_MaxComputeTextureImageUnits, GL_MAX_COMPUTE_TEXTURE_IMAGE_UNITS, 32)
X(gl_MaxComputeAtomicCounters, GL_MAX_COMPUTE_ATOMIC_COUNTERS, 1024)
X(gl_MaxComputeAtomicCounterBuffers, GL_MAX_COMPUTE_ATOMIC_COUNTER_BUFFERS, 8)
X(gl_MaxSamples, GL_MAX_SAMPLES, 4)
X(gl_MaxLights, 0, 8)
X(gl_MaxClipPlanes, GL_MAX_CLIP_PLANES, 8)
X(gl_MaxTextureUnits, GL_MAX_TEXTURE_UNITS, 8)
X(gl_MaxTextureCoords, GL_MAX_TEXTURE_COORDS, 8)
X(gl_MaxCombinedShaderOutputResources, GL_MAX_COMBINED_SHADER_OUTPUT_RESOURCES, 32)
